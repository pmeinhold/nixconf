// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://niri-wm.github.io/niri/Configuration:-Introduction

input {
    keyboard {
        xkb {
            layout "eu"
        }

        repeat-delay 200
        // repeat-rate 25  // default is fine
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        // natural-scroll
    }

    // Niri doesn't warp the cursor to newly-focused windows (matching no_warps = true).
    // warp-mouse-to-focus
}

// Outputs: niri will mirror by default when a second output is connected.
// Uncomment and configure when needed:
// output "eDP-1" {
//     mode "1920x1080@60"
//     scale 1
//     transform "normal"
// }

layout {
    // gaps_in=4, gaps_out=8 from hyprland:
    // niri's gap applies to all sides; struts add outer margin on top of gaps.
    gaps 4
    struts {
        left   4
        right  4
        top    4
        bottom 4
    }

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Use border (always visible) rather than focus-ring (active only),
    // matching hyprland where all windows have a visible border.
    focus-ring {
        off
    }

    border {
        width 2
        // Active: green → teal gradient (matches hyprland active_border)
        active-gradient   from="#a6e3a1ee" to="#89dcebee" angle=45
        // Inactive: surface0 (matches hyprland inactive_border)
        inactive-color "#313244"
    }

    shadow {
        // off by default (matches hyprland shadow.enabled = false)
    }
}

// Match hyprland's exec-once list.
spawn-at-startup "waybar"
spawn-at-startup "udiskie"
spawn-at-startup "nm-applet"
spawn-at-startup "blueman-applet"
spawn-at-startup "tailscale-systray"
spawn-at-startup "stretchly"
spawn-sh-at-startup "awww-daemon || awww img ~/dev/nixconf/pics/waves-light.jpg"

hotkey-overlay {
    // wlr-which-key handles discoverability; skip niri's built-in overlay at startup.
    skip-at-startup
}

// Remove client-side decorations where possible, so niri draws borders/rounding.
prefer-no-csd

// Save screenshots to Desktop (matches hyprland's grim output path convention).
screenshot-path "~/Desktop/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // slowdown 1.0
}

// ── Window rules ────────────────────────────────────────────────────────────

// Rounded corners for all windows (matches hyprland decoration.rounding = 8).
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// WezTerm initial-configure workaround.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox picture-in-picture floats.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// ── Binds ───────────────────────────────────────────────────────────────────
//
// Navigation note: niri uses a scrolling column model, so Mod+H/L move between
// columns within a workspace (not between workspaces as in hyprland). Workspace
// navigation uses Mod+U/I or Mod+Page_Up/Down. Everything else maps directly.
//
binds {
    // ── App keychords (wlr-which-key, WM-agnostic) ──────────────────────
    Mod+Space { spawn "wlr-which-key"; }

    // ── Hotkey reference ─────────────────────────────────────────────────
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── Window management ────────────────────────────────────────────────
    Mod+Shift+Q repeat=false { close-window; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F  repeat=false { toggle-window-floating; }
    Mod+V       { switch-focus-between-floating-and-tiling; }

    // ── Focus navigation (hjkl + arrows) ────────────────────────────────
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // ── Move windows (matches hyprland Mod+Shift+J/K swapnext/swapprev) ─
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // Move column to adjacent workspace (matches hyprland Mod+Shift+H/L → workspace ±1).
    // Niri workspaces are vertical, so "left/right" maps to "up/down".
    Mod+Shift+H { move-column-to-workspace-up; }
    Mod+Shift+L { move-column-to-workspace-down; }

    // Move column within workspace (arrow keys only — hjkl used for focus/workspace).
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // ── Resize (matches hyprland Mod+Ctrl+H/J/K/L → resizeactive) ───────
    Mod+Ctrl+H { set-column-width  "-10%"; }
    Mod+Ctrl+L { set-column-width  "+10%"; }
    Mod+Ctrl+K { set-window-height "-10%"; }
    Mod+Ctrl+J { set-window-height "+10%"; }

    // Fine-grained width/height (niri extras, no hyprland equivalent).
    Mod+Minus       { set-column-width  "-10%"; }
    Mod+Equal       { set-column-width  "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ── Monitor navigation (arrows only; hjkl re-used above) ────────────
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }

    // ── Workspace navigation ─────────────────────────────────────────────
    // Numbered (matches hyprland Mod+1-4 and Mod+Shift+1-4).
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    // Ctrl+1-4 as aliases for the same actions.
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }

    // Relative (Page keys + U/I for keyboard-friendly access).
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Page_Down      { focus-workspace-down; }
    Mod+U              { focus-workspace-up; }
    Mod+I              { focus-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+U         { move-column-to-workspace-up; }
    Mod+Ctrl+I         { move-column-to-workspace-down; }

    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }

    // ── Wheel / touchpad scroll ───────────────────────────────────────────
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+WheelScrollLeft      { focus-column-left; }
    Mod+WheelScrollRight     { focus-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }

    // ── Niri column/window extras ─────────────────────────────────────────
    Mod+O repeat=false { toggle-overview; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R         { switch-preset-column-width; }
    Mod+Shift+R   { switch-preset-column-width-back; }
    Mod+Ctrl+R    { reset-window-height; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+M         { maximize-window-to-edges; }
    Mod+C         { center-column; }
    Mod+Ctrl+C    { center-visible-columns; }
    Mod+W         { toggle-column-tabbed-display; }

    // ── Screenshot ────────────────────────────────────────────────────────
    // wlr-which-key "p" runs grim+slurp (see keychords.nix).
    // These use niri's native interactive screenshot instead.
    Print         { screenshot; }
    Ctrl+Print    { screenshot-screen; }
    Alt+Print     { screenshot-window; }

    // ── Session ───────────────────────────────────────────────────────────
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E    { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P    { power-off-monitors; }

    // ── Media & brightness ────────────────────────────────────────────────
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.5"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop  allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    // Mod+audio keys → brightness (matches hyprland Mod+XF86Audio* binding).
    Mod+XF86AudioRaiseVolume { spawn "brightnessctl" "set" "+5%"; }
    Mod+XF86AudioLowerVolume { spawn "brightnessctl" "set" "5%-"; }
}
